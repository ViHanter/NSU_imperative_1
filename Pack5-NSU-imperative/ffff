#include <stdio.h>

double fact(double num){
    int res = 1;
    for (int i=1;i<=num;i++){
        res*=i;
    }
    return res;
}
double power(double a,int b){
    float res=1.0;
    for (int i=0;i<b;i++) res*=a;
    return res;
}
double get_exp(float x){
    if (x<0.0) x*=-1;
    if (x==0.0) return 1.0;
    double num = 1.0;
    double res = 0.0;
    int n = 1;
    while (num>1e-15){
        res+=num;
        n++;
        num = power(x,n)/fact(n);
    }
    return res;
}

int main(){
    freopen("input.txt","r",stdin);
    freopen("output.txt","w",stdout);

    int n;
    scanf("%d",&n);

    float x;
    for (int i=0;i<n;i++){
        scanf("%f",&x);
        printf("%0.15g\n",get_exp(x));
    }
    return 0;
}